generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  READER
  ADMIN
}

enum PostType {
  STORY
  BLOG
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum AccessLevel {
  FREE
  PREMIUM
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

enum MembershipStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum NewsletterStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELED
}

enum NewsletterAudience {
  ALL
  FREE
  PREMIUM
  FOLLOWERS
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  PAYPAL
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  NEW_POST
  COMMENT_REPLY
  MEMBERSHIP
  ANNOUNCEMENT
  SERIES_UPDATE
}

enum SupporterVisibility {
  PUBLIC
  ANONYMOUS
}

model User {
  id                      String                   @id @default(cuid()) @map("_id")
  name                    String?
  email                   String?                  @unique
  emailVerified           DateTime?
  image                   String?
  username                String?                  @unique
  passwordHash            String?
  bio                     String?
  role                    UserRole                 @default(READER)
  membershipStatus        MembershipStatus         @default(NONE)
  membershipPlanId        String?
  membershipPlan          MembershipPlan?          @relation(fields: [membershipPlanId], references: [id])
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  accounts                Account[]
  sessions                Session[]
  admin                   Admin?
  posts                   Post[]
  comments                Comment[]
  appreciations           Appreciation[]
  bookmarks               Bookmark[]
  readingHistory          ReadingHistory[]
  achievements            UserAchievement[]
  notifications           Notification[]
  donations               Donation[]
  tips                    Tip[]
  followingAuthor         AuthorFollower[]
  seriesFollows           SeriesFollow[]
  readingStreak           ReadingStreak?
  subscriptions           MembershipSubscription[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  reports                 CommentReport[]
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid()) @map("_id")
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(cuid()) @map("_id")
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(cuid()) @map("_id")
  userId    String   @unique
  title     String   @default("Editor")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  slug        String   @unique
  description String?
  type        PostType?
  posts       Post[]
  createdAt   DateTime @default(now())
}

model Tag {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  slug      String   @unique
  postIds   String[]
  posts     Post[]   @relation(fields: [postIds], references: [id])
  createdAt DateTime @default(now())
}

model Post {
  id                String            @id @default(cuid()) @map("_id")
  title             String
  slug              String            @unique
  type              PostType
  status            PostStatus        @default(DRAFT)
  accessLevel       AccessLevel       @default(FREE)
  coverImage        String?
  excerpt           String
  content           String
  writerNote        String?
  metaTitle         String?
  metaDescription   String?
  canonicalUrl      String?
  ogImage           String?
  readingTime       Int               @default(1)
  wordCount         Int               @default(0)
  publishDate       DateTime?
  scheduledFor      DateTime?
  featured          Boolean           @default(false)
  allowComments     Boolean           @default(true)
  viewCount         Int               @default(0)
  appreciationCount Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  authorId          String?
  categoryId        String?
  author            User?             @relation(fields: [authorId], references: [id])
  category          Category?         @relation(fields: [categoryId], references: [id])
  tagIds            String[]
  tags              Tag[]             @relation(fields: [tagIds], references: [id])
  comments          Comment[]
  appreciations     Appreciation[]
  bookmarks         Bookmark[]
  readingHistory    ReadingHistory[]
  seriesLinks       SeriesPost[]
  tips              Tip[]
  pageViews         PageView[]
  newsletterItems   NewsletterItem[]

  @@index([type, status, publishDate])
  @@index([accessLevel, status])
}

model Series {
  id          String       @id @default(cuid()) @map("_id")
  title       String
  slug        String       @unique
  description String?
  coverImage  String?
  featured    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  posts       SeriesPost[]
  followers   SeriesFollow[]
}

model SeriesPost {
  id        String @id @default(cuid()) @map("_id")
  seriesId  String
  postId    String
  order     Int
  series    Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([seriesId, postId])
  @@unique([seriesId, order])
}

model SeriesFollow {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  seriesId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
}

model Comment {
  id          String          @id @default(cuid()) @map("_id")
  postId      String
  userId      String?
  parentId    String?
  authorName  String?
  authorEmail String?
  content     String
  status      CommentStatus   @default(PENDING)
  ipHash      String?
  userAgent   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  post        Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent      Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     Comment[]       @relation("CommentReplies")
  reports     CommentReport[]

  @@index([postId, status])
  @@index([parentId])
}

model CommentReport {
  id        String   @id @default(cuid()) @map("_id")
  commentId String
  userId    String?
  reason    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Appreciation {
  id          String   @id @default(cuid()) @map("_id")
  postId      String
  userId      String?
  visitorHash String?
  createdAt   DateTime @default(now())
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([userId, postId])
}

model Bookmark {
  id        String   @id @default(cuid()) @map("_id")
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model ReadingHistory {
  id          String   @id @default(cuid()) @map("_id")
  postId      String
  userId      String
  progress    Int      @default(0)
  completedAt DateTime?
  lastReadAt  DateTime @default(now())
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model ReadingStreak {
  id            String   @id @default(cuid()) @map("_id")
  userId        String   @unique
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  lastReadAt    DateTime?
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String            @id @default(cuid()) @map("_id")
  key         String            @unique
  title       String
  description String
  icon        String
  createdAt   DateTime          @default(now())
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid()) @map("_id")
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Subscriber {
  id                 String       @id @default(cuid()) @map("_id")
  email              String       @unique
  name               String?
  verifiedAt         DateTime?
  unsubscribedAt     DateTime?
  verificationToken  String?      @unique
  unsubscribeToken   String       @unique
  premiumOnly        Boolean      @default(false)
  source             String?
  createdAt          DateTime     @default(now())
  newsletterSends    NewsletterRecipient[]
}

model Newsletter {
  id          String             @id @default(cuid()) @map("_id")
  subject     String
  title       String
  body        String
  template    String
  audience    NewsletterAudience @default(ALL)
  status      NewsletterStatus   @default(DRAFT)
  scheduledFor DateTime?
  sentAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       NewsletterItem[]
  recipients  NewsletterRecipient[]
}

model NewsletterItem {
  id           String     @id @default(cuid()) @map("_id")
  newsletterId String
  postId       String
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model NewsletterRecipient {
  id           String      @id @default(cuid()) @map("_id")
  newsletterId String
  subscriberId String
  sentAt       DateTime?
  openedAt     DateTime?
  newsletter   Newsletter  @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  subscriber   Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([newsletterId, subscriberId])
}

model MembershipPlan {
  id              String                   @id @default(cuid()) @map("_id")
  name            String
  slug            String                   @unique
  description     String
  priceCents      Int
  currency        String                   @default("USD")
  interval        BillingInterval
  features        String[]
  active          Boolean                  @default(true)
  stripePriceId   String?
  razorpayPlanId  String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  users           User[]
  subscriptions   MembershipSubscription[]
}

model MembershipSubscription {
  id                   String           @id @default(cuid()) @map("_id")
  userId               String
  planId               String
  status               MembershipStatus @default(ACTIVE)
  provider             PaymentProvider
  providerCustomerId   String?
  providerSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 MembershipPlan   @relation(fields: [planId], references: [id])
}

model Donation {
  id             String              @id @default(cuid()) @map("_id")
  userId         String?
  name           String?
  email          String?
  message        String?
  amountCents    Int
  currency       String              @default("USD")
  provider       PaymentProvider
  status         PaymentStatus       @default(PENDING)
  visibility     SupporterVisibility @default(PUBLIC)
  providerRef    String?
  createdAt      DateTime            @default(now())
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Tip {
  id             String              @id @default(cuid()) @map("_id")
  postId         String
  userId         String?
  name           String?
  email          String?
  amountCents    Int
  currency       String              @default("USD")
  provider       PaymentProvider
  status         PaymentStatus       @default(PENDING)
  visibility     SupporterVisibility @default(PUBLIC)
  providerRef    String?
  createdAt      DateTime            @default(now())
  post           Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuthorFollower {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model Notification {
  id        String           @id @default(cuid()) @map("_id")
  userId    String
  type      NotificationType
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PageView {
  id          String   @id @default(cuid()) @map("_id")
  postId      String?
  path        String
  visitorHash String?
  referrer    String?
  userAgent   String?
  country     String?
  createdAt   DateTime @default(now())
  post        Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([path, createdAt])
  @@index([postId, createdAt])
}

model ContentImport {
  id        String   @id @default(cuid()) @map("_id")
  source    String
  fileName  String
  status    String
  metadata  Json?
  createdAt DateTime @default(now())
}
